# Copy to .env before running:
#   Copy-Item .env.development.local .env -Force

API_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/stage

COGNITO_REGION=ap-south-1
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_USER_POOL_ID=ap-south-1_yourPoolId

# Staff groups allowed by inventory image APIs (Admin / Ops).
# Comma-separated. Login requires at least one of these groups.
AUTH_ALLOWED_GROUPS=Admin,Ops
